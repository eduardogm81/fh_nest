# Definir variables iniciales
@serverUrl = http://localhost:3000
@id = 4f1ffa65-7366-4316-8047-f50b14118e51

### Obtener todos los coches
GET {{serverUrl}}/cars

### Obtener un coche por id
GET {{serverUrl}}/cars/{{id}}

### Crear un coche nuevo
POST {{serverUrl}}/cars
Content-Type: application/json

{
  "brand": "Volvo",
  "model": "XC40"
}

### Actualizar un coche
PATCH {{serverUrl}}/cars/{{id}}
Content-Type: application/json

{
  "brand": "Toyota1",
  "model": "Corolla2"
}

###
#{
#  "id": "{{id}}",
#  "brand": "Toyota",
#  "model": "Corolla1"
#}

### Borrar un coche
DELETE {{serverUrl}}/cars/{{id}}

